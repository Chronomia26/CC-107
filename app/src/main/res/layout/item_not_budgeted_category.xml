<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_shape_bordered">

        <!-- Icon -->
        <ImageView
            android:id="@+id/imgCategory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_transport"
            app:tint="@color/primaryBlue" />

        <!-- Text + Input Area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNotBudgetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transportation"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvNotBudgetLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not set"
                android:textSize="14sp"
                android:textColor="@color/primaryBlue" />

            <!-- Budget Input -->
            <EditText
                android:id="@+id/editBudgetAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_enter_amount"
                android:inputType="numberDecimal"
                android:paddingTop="4dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Set Budget Button -->
        <Button
            android:id="@+id/btnSetBudget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_set_budget"
            android:backgroundTint="@color/primaryBlue"
            android:textColor="@android:color/white"
            android:layout_marginEnd="6dp" />

        <!-- More Button -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_more_vert"
            android:background="@android:color/transparent"
            app:tint="@color/textPrimary" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
