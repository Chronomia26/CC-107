<?xml version="1.0" encoding="utf-8"?>
<!--
  This drawable creates a "Neumorphic" or soft UI effect to match the design.
  It uses a layer-list with multiple gradients and shapes to simulate:
  1. A dark, diffuse drop shadow at the bottom.
  2. A light, "highlight" shadow at the top.
  3. A main content background with a subtle inset border.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: The Dark Bottom Shadow (Casted Shadow) -->
    <!-- This is a gradient that goes from a soft grey to transparent. -->
    <!-- It's pushed down by 2dp to create the shadow effect. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:centerColor="#0D000000"
                android:startColor="#1A000000" />
            <padding android:top="4dp" />
        </shape>
    </item>

    <!-- Layer 2: The Main Card with Border and Light Background -->
    <!-- This is the primary visible layer that holds the content. -->
    <item
        android:bottom="4dp"> <!-- This margin pushes the card up, revealing the dark shadow -->
        <shape android:shape="rectangle">
            <!-- Main background color of the card -->
            <solid android:color="#F0F0F0" />

            <!-- Rounded corners matching the design -->
            <corners android:radius="10dp" />

            <!-- A subtle, slightly darker border to match the inset look -->
            <stroke
                android:width="1dp"
                android:color="#DCDCDC" />
        </shape>
    </item>

</layer-list>
